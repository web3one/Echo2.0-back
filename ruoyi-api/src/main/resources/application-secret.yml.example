# ====================================================================
# HD 钱包密钥配置 — 模板文件（committed）
#
# 使用方法：
#   1. 复制本文件为 application-secret.yml（已 gitignore，不会进 git）
#   2. 把 mnemonic 换成你自己离线生成的真实助记词（12 或 24 词）
#   3. 启动时用 secret profile：
#         java -jar echo2-api.jar --spring.profiles.active=dev,secret
#
# 也可以不用本文件，直接设置环境变量：
#   export WALLET_MNEMONIC="abandon abandon abandon ... about"
#
# ⚠️ 注意：admin 和 api 必须使用同一份助记词，否则派生地址不一致
# ====================================================================

wallet:
  mnemonic: "abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about"
  passphrase: ""
