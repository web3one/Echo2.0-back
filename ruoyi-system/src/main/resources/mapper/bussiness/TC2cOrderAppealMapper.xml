<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.bussiness.mapper.TC2cOrderAppealMapper">

    <resultMap type="com.ruoyi.bussiness.domain.TC2cOrderAppeal" id="TC2cOrderAppealResult">
        <result property="id"    column="id"    />
        <result property="appealNo"    column="appeal_no"    />
        <result property="orderId"    column="order_id"    />
        <result property="orderNo"    column="order_no"    />
        <result property="initiatorId"    column="initiator_id"    />
        <result property="respondentId"    column="respondent_id"    />
        <result property="appealType"    column="appeal_type"    />
        <result property="appealReason"    column="appeal_reason"    />
        <result property="evidenceUrls"    column="evidence_urls"    />
        <result property="status"    column="status"    />
        <result property="adminId"    column="admin_id"    />
        <result property="adminResult"    column="admin_result"    />
        <result property="adminParentIds"    column="admin_parent_ids"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectTC2cOrderAppealVo">
        select id, appeal_no, order_id, order_no, initiator_id, respondent_id, appeal_type, appeal_reason, evidence_urls, status, admin_id, admin_result, admin_parent_ids, create_by, create_time, update_by, update_time, remark from t_c2c_order_appeal
    </sql>

    <select id="selectAppealList" parameterType="TC2cOrderAppeal" resultMap="TC2cOrderAppealResult">
        <include refid="selectTC2cOrderAppealVo"/>
        <where>
            <if test="status != null"> and status = #{status}</if>
            <if test="orderNo != null and orderNo != ''"> and order_no = #{orderNo}</if>
            <if test="initiatorId != null"> and initiator_id = #{initiatorId}</if>
            <if test="appealType != null"> and appeal_type = #{appealType}</if>
            <if test="adminParentIds != null and adminParentIds != ''">
                AND find_in_set(#{adminParentIds}, admin_parent_ids)
            </if>
        </where>
        order by CASE WHEN status = 0 THEN 0 ELSE 1 END, create_time desc
    </select>

    <select id="selectByOrderId" parameterType="Long" resultMap="TC2cOrderAppealResult">
        <include refid="selectTC2cOrderAppealVo"/>
        where order_id = #{orderId} limit 1
    </select>

    <select id="selectTC2cOrderAppealById" parameterType="Long" resultMap="TC2cOrderAppealResult">
        <include refid="selectTC2cOrderAppealVo"/>
        where id = #{id}
    </select>

    <insert id="insertTC2cOrderAppeal" parameterType="TC2cOrderAppeal" useGeneratedKeys="true" keyProperty="id">
        insert into t_c2c_order_appeal
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="appealNo != null">appeal_no,</if>
            <if test="orderId != null">order_id,</if>
            <if test="orderNo != null">order_no,</if>
            <if test="initiatorId != null">initiator_id,</if>
            <if test="respondentId != null">respondent_id,</if>
            <if test="appealType != null">appeal_type,</if>
            <if test="appealReason != null">appeal_reason,</if>
            <if test="evidenceUrls != null">evidence_urls,</if>
            <if test="status != null">status,</if>
            <if test="adminId != null">admin_id,</if>
            <if test="adminResult != null">admin_result,</if>
            <if test="adminParentIds != null">admin_parent_ids,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="appealNo != null">#{appealNo},</if>
            <if test="orderId != null">#{orderId},</if>
            <if test="orderNo != null">#{orderNo},</if>
            <if test="initiatorId != null">#{initiatorId},</if>
            <if test="respondentId != null">#{respondentId},</if>
            <if test="appealType != null">#{appealType},</if>
            <if test="appealReason != null">#{appealReason},</if>
            <if test="evidenceUrls != null">#{evidenceUrls},</if>
            <if test="status != null">#{status},</if>
            <if test="adminId != null">#{adminId},</if>
            <if test="adminResult != null">#{adminResult},</if>
            <if test="adminParentIds != null">#{adminParentIds},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateTC2cOrderAppeal" parameterType="TC2cOrderAppeal">
        update t_c2c_order_appeal
        <trim prefix="SET" suffixOverrides=",">
            <if test="appealNo != null">appeal_no = #{appealNo},</if>
            <if test="orderId != null">order_id = #{orderId},</if>
            <if test="orderNo != null">order_no = #{orderNo},</if>
            <if test="initiatorId != null">initiator_id = #{initiatorId},</if>
            <if test="respondentId != null">respondent_id = #{respondentId},</if>
            <if test="appealType != null">appeal_type = #{appealType},</if>
            <if test="appealReason != null">appeal_reason = #{appealReason},</if>
            <if test="evidenceUrls != null">evidence_urls = #{evidenceUrls},</if>
            <if test="status != null">status = #{status},</if>
            <if test="adminId != null">admin_id = #{adminId},</if>
            <if test="adminResult != null">admin_result = #{adminResult},</if>
            <if test="adminParentIds != null">admin_parent_ids = #{adminParentIds},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteTC2cOrderAppealById" parameterType="Long">
        delete from t_c2c_order_appeal where id = #{id}
    </delete>

    <delete id="deleteTC2cOrderAppealByIds" parameterType="String">
        delete from t_c2c_order_appeal where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
