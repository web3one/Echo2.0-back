    <sql id="selectTC2cOrderVo">
        select id, order_no, ad_id, ad_no, ad_type, crypto_currency, fiat_currency, price, crypto_amount, fiat_amount, buyer_id, seller_id, merchant_id, taker_id, payment_method_id, status, pay_time, release_time, cancel_time, cancel_reason, cancelled_by, timeout_at, admin_parent_ids, create_by, create_time, update_by, update_time, remark from t_c2c_order
    </sql>

    <select id="selectOrderList" parameterType="TC2cOrder" resultMap="TC2cOrderResult">
        <include refid="selectTC2cOrderVo"/>
        <where>
            <if test="orderNo != null and orderNo != ''"> and order_no = #{orderNo}</if>
            <if test="status != null"> and status = #{status}</if>
            <if test="buyerId != null"> and buyer_id = #{buyerId}</if>
            <if test="sellerId != null"> and seller_id = #{sellerId}</if>
            <if test="merchantId != null"> and merchant_id = #{merchantId}</if>
            <if test="cryptoCurrency != null and cryptoCurrency != ''"> and lower(crypto_currency) = lower(#{cryptoCurrency})</if>
            <if test="adminParentIds != null and adminParentIds != ''">
                AND find_in_set(#{adminParentIds}, admin_parent_ids)
            </if>
            <if test="params != null and params != ''">
                <if test="params.startTime != null">
                    and create_time <![CDATA[ >= ]]> #{params.startTime}
                </if>
                <if test="params.endTime != null">
                    and create_time <![CDATA[ <= ]]> #{params.endTime}
                </if>
            </if>
        </where>
        order by create_time desc
    </select>

    <select id="selectOrderVOList" parameterType="TC2cOrder" resultMap="C2cOrderVOResult">
        select o.id, o.order_no, o.ad_id, o.ad_no, o.ad_type, o.crypto_currency, o.fiat_currency,
        o.price, o.crypto_amount, o.fiat_amount, o.buyer_id, o.seller_id, o.merchant_id,
        o.taker_id, o.status, o.create_time, o.pay_time, o.release_time, o.cancel_time,
        o.timeout_at, o.cancel_reason, o.cancelled_by,
        buyer.login_name as buyer_name, seller.login_name as seller_name,
        m.nickname as merchant_nickname
        from t_c2c_order o
        left join t_app_user buyer on o.buyer_id = buyer.user_id
        left join t_app_user seller on o.seller_id = seller.user_id
        left join t_c2c_merchant m on o.merchant_id = m.id
        <where>
            <if test="orderNo != null and orderNo != ''"> and o.order_no = #{orderNo}</if>
            <if test="status != null"> and o.status = #{status}</if>
            <if test="buyerId != null"> and o.buyer_id = #{buyerId}</if>
            <if test="sellerId != null"> and o.seller_id = #{sellerId}</if>
            <if test="merchantId != null"> and o.merchant_id = #{merchantId}</if>
            <if test="cryptoCurrency != null and cryptoCurrency != ''"> and lower(o.crypto_currency) = lower(#{cryptoCurrency})</if>
            <if test="adminParentIds != null and adminParentIds != ''">
                AND find_in_set(#{adminParentIds}, o.admin_parent_ids)
            </if>
            <if test="params != null and params != ''">
                <if test="params.startTime != null">
                    and o.create_time <![CDATA[ >= ]]> #{params.startTime}
                </if>
                <if test="params.endTime != null">
                    and o.create_time <![CDATA[ <= ]]> #{params.endTime}
                </if>
            </if>
        </where>
        order by o.create_time desc
    </select>

    <select id="selectTC2cOrderById" parameterType="Long" resultMap="TC2cOrderResult">
        <include refid="selectTC2cOrderVo"/>
        where id = #{id}
    </select>

    <select id="selectTimeoutOrders" resultMap="TC2cOrderResult">
        select id, order_no, ad_id, ad_no, ad_type, crypto_currency, fiat_currency, price,
        crypto_amount, fiat_amount, buyer_id, seller_id, merchant_id, taker_id, payment_method_id,
        status, pay_time, release_time, cancel_time, cancel_reason, cancelled_by, timeout_at,
        admin_parent_ids, create_by, create_time, update_by, update_time, remark
        from t_c2c_order
        where status = 0 and timeout_at is not null and timeout_at &lt; NOW()
    </select>

    <select id="countDailyCancelByUser" parameterType="Long" resultType="int">
        select count(*) from t_c2c_order
        where ((buyer_id = #{userId} and cancelled_by = 'buyer')
            or (seller_id = #{userId} and cancelled_by = 'seller'))
            and status = 3 and DATE(cancel_time) = CURDATE()
    </select>

    <select id="countActiveOrdersByUser" parameterType="Long" resultType="int">
        select count(*) from t_c2c_order
        where (buyer_id = #{userId} or seller_id = #{userId})
            and status in (0, 1, 4)
    </select>

