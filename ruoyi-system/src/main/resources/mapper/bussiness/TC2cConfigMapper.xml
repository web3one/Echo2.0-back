<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.bussiness.mapper.TC2cConfigMapper">

    <resultMap type="com.ruoyi.bussiness.domain.TC2cConfig" id="TC2cConfigResult">
        <result property="id"    column="id"    />
        <result property="configKey"    column="config_key"    />
        <result property="configValue"    column="config_value"    />
        <result property="configDesc"    column="config_desc"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectTC2cConfigVo">
        select id, config_key, config_value, config_desc, create_time, update_time from t_c2c_config
    </sql>

    <select id="selectByKey" parameterType="String" resultMap="TC2cConfigResult">
        <include refid="selectTC2cConfigVo"/>
        where config_key = #{configKey}
    </select>

    <select id="selectTC2cConfigList" parameterType="TC2cConfig" resultMap="TC2cConfigResult">
        <include refid="selectTC2cConfigVo"/>
        <where>
            <if test="configKey != null and configKey != ''"> and config_key = #{configKey}</if>
            <if test="configDesc != null and configDesc != ''"> and config_desc like concat('%', #{configDesc}, '%')</if>
        </where>
    </select>

    <select id="selectTC2cConfigById" parameterType="Long" resultMap="TC2cConfigResult">
        <include refid="selectTC2cConfigVo"/>
        where id = #{id}
    </select>

    <insert id="insertTC2cConfig" parameterType="TC2cConfig" useGeneratedKeys="true" keyProperty="id">
        insert into t_c2c_config
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="configKey != null">config_key,</if>
            <if test="configValue != null">config_value,</if>
            <if test="configDesc != null">config_desc,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="configKey != null">#{configKey},</if>
            <if test="configValue != null">#{configValue},</if>
            <if test="configDesc != null">#{configDesc},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <update id="updateTC2cConfig" parameterType="TC2cConfig">
        update t_c2c_config
        <trim prefix="SET" suffixOverrides=",">
            <if test="configKey != null">config_key = #{configKey},</if>
            <if test="configValue != null">config_value = #{configValue},</if>
            <if test="configDesc != null">config_desc = #{configDesc},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteTC2cConfigById" parameterType="Long">
        delete from t_c2c_config where id = #{id}
    </delete>

    <delete id="deleteTC2cConfigByIds" parameterType="String">
        delete from t_c2c_config where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
